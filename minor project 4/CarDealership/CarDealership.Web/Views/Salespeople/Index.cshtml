@model IEnumerable<CarDealership.Data.Entities.Salesperson>
@{
    ViewData["Title"] = "Sales Staff";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Sales Representatives</h2>
    <a asp-action="Create" class="btn btn-success">+ Add New Representative</a>
</div>

<table class="table table-striped table-hover border">
    <thead class="table-dark">
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Commission Rate</th>
            <th>Dealership Branch</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td class="fw-semibold">@item.FullName</td>
            <td>@item.Email</td>
            <td>@item.Phone</td>
            <td>@item.CommissionRate%</td>
            <td>@item.Dealership?.BranchName</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SalespersonId" class="btn btn-sm btn-outline-primary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.SalespersonId" class="btn btn-sm btn-outline-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.SalespersonId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>