@model CarDealership.Data.Entities.Dealership
@{
    ViewData["Title"] = "Admin - Edit Branch";
}
<h2>Modify Dealership Branch</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="DealershipId" />
            <div class="mb-2">
                <label asp-for="BranchName" class="form-label"></label>
                <input asp-for="BranchName" class="form-control" required />
            </div>
            <div class="row mb-2">
                <div class="col">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" required />
                </div>
                <div class="col">
                    <label asp-for="State" class="form-label"></label>
                    <input asp-for="State" class="form-control" maxlength="2" required />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Update Branch</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>