@model IEnumerable<CarDealership.Data.Entities.Dealership>
@{
    ViewData["Title"] = "Admin - Dealership Branches";
}

<div class="alert alert-warning border-warning d-flex justify-content-between align-items-center">
    <div>
        <strong>Admin Control Area:</strong> Only system administrators are authorized to create, update, or decommission dealership branches.
    </div>
    <a asp-action="Create" class="btn btn-sm btn-dark">+ Add Dealership Branch</a>
</div>

<table class="table table-striped table-hover border">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Branch Name</th>
            <th>City</th>
            <th>State</th>
            <th>Phone</th>
            <th>Admin Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.DealershipId</td>
            <td class="fw-semibold">@item.BranchName</td>
            <td>@item.City</td>
            <td>@item.State</td>
            <td>@item.Phone</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.DealershipId" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.DealershipId" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.DealershipId" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>