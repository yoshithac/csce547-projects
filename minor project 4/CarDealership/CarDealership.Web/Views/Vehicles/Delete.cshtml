@model CarDealership.Data.Entities.Vehicle
@{
    ViewData["Title"] = "Delete Vehicle";
}
<h2 class="text-danger">Delete Confirmation</h2>
<h4>Are you sure you want to permanently delete this vehicle?</h4>
<div class="card p-3 my-3">
    <dl class="row">
        <dt class="col-sm-2">VIN</dt>
        <dd class="col-sm-10"><code>@Model.VIN</code></dd>
        <dt class="col-sm-2">Vehicle</dt>
        <dd class="col-sm-10">@Model.Year @Model.Make @Model.Model</dd>
        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Price.ToString("C")</dd>
        <dt class="col-sm-2">Mileage</dt>
        <dd class="col-sm-10">@Model.Mileage.ToString("N0") mi</dd>
    </dl>
</div>
<form asp-action="Delete">
    <input type="hidden" asp-for="VehicleId" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>