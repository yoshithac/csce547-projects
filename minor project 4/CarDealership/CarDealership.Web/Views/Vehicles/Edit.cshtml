@model CarDealership.Data.Entities.Vehicle
@{
    ViewData["Title"] = "Edit Vehicle";
}
<h2>Edit Vehicle: @Model.Make @Model.Model</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="VehicleId" />
            <div class="mb-2">
                <label asp-for="VIN" class="form-label"></label>
                <input asp-for="VIN" class="form-control" required maxlength="17" />
            </div>
            <div class="row mb-2">
                <div class="col">
                    <label asp-for="Make" class="form-label"></label>
                    <input asp-for="Make" class="form-control" required />
                </div>
                <div class="col">
                    <label asp-for="Model" class="form-label"></label>
                    <input asp-for="Model" class="form-control" required />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col">
                    <label asp-for="Year" class="form-label"></label>
                    <input asp-for="Year" type="number" class="form-control" required />
                </div>
                <div class="col">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col">
                    <label asp-for="Color" class="form-label"></label>
                    <input asp-for="Color" class="form-control" required />
                </div>
                <div class="col">
                    <label asp-for="Mileage" class="form-label"></label>
                    <input asp-for="Mileage" type="number" class="form-control" required />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Assigned Dealership</label>
                <select asp-for="DealershipId" class="form-select" asp-items="ViewBag.DealershipId"></select>
            </div>
            <button type="submit" class="btn btn-primary">Update Vehicle</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>