@model IEnumerable<CarDealership.Data.Entities.Vehicle>
@{
    ViewData["Title"] = "Vehicle Inventory";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Vehicle Inventory</h2>
    <a asp-action="Create" class="btn btn-success">+ Add New Vehicle</a>
</div>

<form asp-action="Index" method="get" class="card card-body mb-3 p-3">
    <div class="row g-2 align-items-center">
        <div class="col-md-9">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" 
                   class="form-control" placeholder="Search by Make, Model, or VIN..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<table class="table table-striped table-hover border">
    <thead class="table-dark">
        <tr>
            <th>VIN</th>
            <th>Make</th>
            <th>Model</th>
            <th>Year</th>
            <th>Price</th>
            <th>Mileage</th>
            <th>Dealership</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td><code>@item.VIN</code></td>
            <td>@item.Make</td>
            <td>@item.Model</td>
            <td>@item.Year</td>
            <td>@item.Price.ToString("C")</td>
            <td>@item.Mileage.ToString("N0") mi</td>
            <td>@item.Dealership?.BranchName</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-primary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>