@{
    var theme = Context.Request.Cookies["AppTheme"] ?? "light";
    var density = Context.Request.Cookies["AppDensity"] ?? "standard";
    var isDark = theme == "dark";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@(isDark ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoTrack Systems</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
        }
        .navbar-brand {
            letter-spacing: 0.5px;
            font-weight: 700;
        }
        .density-compact td, .density-compact th {
            padding: 0.45rem 0.65rem !important;
            font-size: 0.88rem;
        }
        .density-standard td, .density-standard th {
            padding: 0.85rem 0.75rem !important;
        }
        .table-card {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
        }
        .action-btn-group .btn {
            padding: 0.25rem 0.6rem;
            font-size: 0.82rem;
            border-radius: 6px;
        }
        .badge-vin {
            font-family: Consolas, monospace;
            background-color: rgba(108, 117, 125, 0.15);
            color: inherit;
            border: 1px solid rgba(108, 117, 125, 0.3);
            padding: 0.2rem 0.45rem;
            border-radius: 4px;
        }
    </style>
</head>
<body class="@(isDark ? "bg-dark text-light" : "bg-light text-dark")">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg @(isDark ? "navbar-dark bg-black" : "navbar-light bg-white") border-bottom shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand text-primary d-flex align-items-center gap-2" asp-controller="Vehicles" asp-action="Index">
                    <i class="bi bi-car-front-fill fs-4"></i>
                    <span>AutoTrack Dealerships</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Vehicles" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Inventory
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Salespeople" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Sales Staff
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 text-warning fw-semibold" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-shield-lock me-1"></i> Admin Portal
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Settings" asp-action="Index">
                                <i class="bi bi-gear-fill me-1"></i> Settings
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 py-4">
        <main role="main" class="@(density == "compact" ? "density-compact" : "density-standard")">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>