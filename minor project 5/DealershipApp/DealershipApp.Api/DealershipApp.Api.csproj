<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- SERVICE LAYER: ASP.NET Core Web API that exposes the business layer over HTTP. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the app run on a newer .NET runtime (9 or 10) if .NET 8 isn't installed. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DealershipApp.Business\DealershipApp.Business.csproj" />
    <ProjectReference Include="..\DealershipApp.Data\DealershipApp.Data.csproj" />
  </ItemGroup>

</Project>
