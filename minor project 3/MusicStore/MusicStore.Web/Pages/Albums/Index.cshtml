@page
@model IndexModel
@{ ViewData["Title"] = "Albums"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Albums</h2>
    <a class="btn btn-success" asp-page="Edit">+ Add Album</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><input name="q" value="@Model.Q" class="form-control" placeholder="Search by title, genre, or artist..." /></div>
    <div class="col-auto">
        <button class="btn btn-primary">Search</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Clear</a>
    </div>
</form>
@if (!Model.Albums.Any())
{
    <div class="alert alert-info">No albums found.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Title</th><th>Artist</th><th>Genre</th><th>Year</th><th>Price</th><th>Stock</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in Model.Albums)
        {
            <tr>
                <td>@a.Title</td><td>@a.ArtistName</td><td>@a.Genre</td><td>@a.ReleaseYear</td>
                <td>@a.Price.ToString("C")</td><td>@a.Stock</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@a.AlbumId">Edit</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@a.AlbumId" asp-route-q="@Model.Q" class="d-inline"
                          onsubmit="return confirm('Delete this album?');">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
