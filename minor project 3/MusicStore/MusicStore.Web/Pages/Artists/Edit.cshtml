@page "{id:int?}"
@model EditModel
@{ ViewData["Title"] = Model.Item.ArtistId == 0 ? "Add Artist" : "Edit Artist"; }
<h2>@ViewData["Title"]</h2>
<form method="post" class="col-md-6">
    <input type="hidden" asp-for="Item.ArtistId" />
    <div class="mb-3"><label asp-for="Item.Name" class="form-label"></label><input asp-for="Item.Name" class="form-control" /><span asp-validation-for="Item.Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Item.Country" class="form-label"></label><input asp-for="Item.Country" class="form-control" /><span asp-validation-for="Item.Country" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Item.ActiveSince" class="form-label"></label><input asp-for="Item.ActiveSince" type="number" class="form-control" /><span asp-validation-for="Item.ActiveSince" class="text-danger"></span></div>
    <button class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
</form>
