@{
    var dark = Context.Request.Cookies["theme"] == "dark";
    var admin = Context.Request.IsAdmin();
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@(dark ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Vinyl Vault</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand bg-body-tertiary border-bottom mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index">&#127925; Vinyl Vault</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-page="/Albums/Index">Albums</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Customers/Index">Customers</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Artists/Index">Artists (Admin)</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Settings">Settings</a></li>
            </ul>
            @if (admin) { <span class="badge text-bg-warning">Admin Mode</span> }
        </div>
    </nav>
    <div class="container pb-5">
        @if (TempData["Message"] is string msg) { <div class="alert alert-success">@msg</div> }
        @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
        @RenderBody()
    </div>
</body>
</html>
